# Copy this file to .env.docker and fill in real values.
# NEVER commit .env.docker — it holds secrets.

# Frontend overrides
VITE_API_URL=http://localhost:5000

# Backend overrides
AI_ENGINE_URL=http://ai-engine:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# AI Engine overrides
UVICORN_RELOAD=true

# Required backend secrets — replace with your own values.
# The backend refuses to start if SESSION_SECRET or REPOSAGE_API_KEY is left
# at one of these placeholder defaults (see validateSessionSecret).
SESSION_SECRET=change-me-to-a-random-secret
REPOSAGE_API_KEY=change-me-to-a-random-api-key
