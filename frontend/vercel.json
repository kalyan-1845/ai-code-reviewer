{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reposage-backend.onrender.com/api/:path*"
    },
    {
      "source": "/webhook/:path*",
      "destination": "https://reposage-backend.onrender.com/webhook/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
