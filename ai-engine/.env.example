# RepoSage AI Engine Configuration
# Copy this file to .env and fill in your values.

# Groq API Key for LLM-powered code reviews (required)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override the .env file path at runtime
# AI_ENGINE_ENV_FILE=/path/to/custom/.env
