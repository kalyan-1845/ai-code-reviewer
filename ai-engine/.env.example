# RepoSage AI Engine Environment Variables
# The AI Engine can also read variables from '../backend/.env' automatically if present.

# Groq API Key (required for AI functionality)
# NOTE: Must NOT be prefixed with VITE_ — that prefix exposes keys to client bundles.
GROQ_API_KEY=your_groq_api_key_here
# Shared secret required on internal AI engine routes. Configure the same value
# as AI_ENGINE_API_KEY/REPOSAGE_API_KEY in the Express backend.
REPOSAGE_API_KEY=replace_with_a_shared_internal_service_key
AI_ENGINE_API_KEY=replace_with_a_shared_internal_service_key

# CORS — comma-separated list of origins allowed to call this service.
# In production, set this to the backend's origin only (the frontend never calls
# the AI engine directly — all traffic goes through the Express backend).
# Example: ALLOWED_ORIGINS=http://localhost:5000,https://your-backend.example.com
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# Embedding model (default: all-MiniLM-L6-v2 — 384-dimensional vectors)
# Use any HuggingFace sentence-transformers model identifier
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Text Splitting (for RAG chunking)
# Chunk size in characters (~1000 tokens), overlap between consecutive chunks
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=200

# ChromaDB Vector Database
# Set CHROMA_HOST to connect to a ChromaDB server (e.g. "chromadb" when running via Docker Compose)
# Leave empty to use embedded PersistentClient mode (local file-based storage)
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=reposage_code_chunks
CHROMA_PERSIST_DIR=./chroma_data

# LangSmith & OpenTelemetry Tracing (Observability / DevOps #3057)
# Enable V2 tracing in LangChain for real-time node metrics and token tracking
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=reposage-ai-engine

# OpenTelemetry OTLP Exporter Endpoint (e.g., Jaeger, Zipkin, SignOz, Datadog OTLP collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
