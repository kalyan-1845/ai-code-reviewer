# -------------------------------------------------------------
# RepoSage Backend Environment Variables
# -------------------------------------------------------------

# Port to run the backend on
PORT=5000

# URL of the AI Engine service
AI_ENGINE_URL=http://localhost:8000

# Personal Access Token for GitHub API requests (Required for fetching repo data)
GITHUB_PAT=your_github_personal_access_token_here

# Secret used to verify incoming GitHub webhook payloads
WEBHOOK_SECRET=your_github_webhook_secret_here

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Timeout for git clone operations in milliseconds (default: 120000)
GIT_CLONE_TIMEOUT=120000

# Maximum repository size in MB that can be scanned (default: 100)
MAX_REPO_SIZE_MB=100

# API key for secure communication and webhook authentication
REPOSAGE_API_KEY=your_secure_api_key_here

# MongoDB connection string for storing repository metadata and scans
MONGODB_URI=mongodb://localhost:27017/reposage

# Set to 'false' when running without a reverse proxy (e.g. plain local dev).
# When 'true' (default), Express trusts the X-Forwarded-For header from the first proxy hop.
TRUST_PROXY=true

# Cache Time-To-Live for analysis results in minutes (default: 60)
ANALYSIS_CACHE_TTL_MINUTES=60

# Redis connection URL (Required for rate limiting and caching if used)
REDIS_URL=redis://localhost:6379

# Maximum size for JSON body parsing (default: '5mb')
JSON_BODY_LIMIT=5mb

# Node environment setting ('development' or 'production')
NODE_ENV=development

# Maximum length for system prompt (default: 2000)
MAX_SYSTEM_PROMPT_LENGTH=2000

# Secret for session management (defaults to REPOSAGE_API_KEY if not set)
SESSION_SECRET=your_session_secret_here

# Maximum line length to scan for secrets (default: 2000)
SECRETS_MAX_LINE_LENGTH=2000

# Timeout for secret scanning per file in ms (default: 100)
SECRETS_SCAN_TIMEOUT_MS=100

# Maximum number of changes to process for secrets (default: 500)
SECRETS_MAX_CHANGES=500

# Label to apply for auto-merging PRs (default: 'gssoc:approved')
AUTO_MERGE_LABEL=gssoc:approved
